_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
# Ignore folders generated by Bundler
.bundle/
vendor/

# Local GA credentials — NEVER commit these.
# (The GitHub Actions workflow reads GA_CREDENTIALS_JSON from a secret,
# so there's no reason for a credentials file to ever exist in the repo.)
*-credentials.json
ga-credentials.json
service-account-key.json

# Python
__pycache__/
*.pyc
.venv/

